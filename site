    <!-- Lógica de Filtro, Busca e Agendamento -->
    <script>
        const buttons = [...document.querySelectorAll('.filter')];
        const cards = [...document.querySelectorAll('.card')];
        const search = document.getElementById('search');
        let category = 'todos';

        function update() {
            const term = search.value.trim().toLocaleLowerCase('pt-BR');
            cards.forEach(c => {
                const matchCat = category === 'todos' || c.dataset.category === category;
                const matchText = (c.dataset.name + ' ' + c.innerText).toLocaleLowerCase('pt-BR').includes(term);
                c.style.display = matchCat && matchText ? 'flex' : 'none';
            });
        }

        buttons.forEach(b => b.addEventListener('click', () => {
            buttons.forEach(x => x.classList.remove('active'));
            b.classList.add('active');
            category = b.dataset.filter;
            update();
        }));

        search.addEventListener('input', update);

        document.querySelectorAll('.book').forEach(a => {
            const service = a.dataset.service;
            const msg = `Olá, Thatiele! Tenho interesse em agendar: ${service}. Pode me informar os horários disponíveis?`;
            a.href = 'https://wa.me/5581985981408?text=' + encodeURIComponent(msg);
            a.target = '_blank';
            a.rel = 'noopener';
        });
    </script>
